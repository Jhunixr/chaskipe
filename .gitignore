# ---------- Node / Frontend ----------
node_modules/
dist/
dist-ssr/
build/
*.local
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python / Backend / IA ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# ---------- Variables de entorno ----------
.env
.env.*
!.env.example

# ---------- Modelos y datos pesados ----------
