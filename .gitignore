# ---------- Node / Frontend ----------
node_modules/
dist/
dist-ssr/
build/
*.local
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python / Backend / IA ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# ---------- Variables de entorno ----------
.env
.env.*
!.env.example

# ---------- Modelos y datos pesados ----------
# Las grabaciones del dataset y los modelos entrenados NO se versionan
# (ver ai/data/DATASET_FORMAT.md). Se conservan la estructura de carpetas,
# los .gitkeep, los README y los .md de documentacion.
ai/data/raw/**/*.json
ai/data/processed/**
!ai/data/processed/.gitkeep
ai/models/*
!ai/models/.gitkeep
# Modelo exportado al frontend: se genera con ai/scripts/export_tfjs.py,
# no se versiona (puede ser sintetico de prueba). Se conserva el README.
frontend/public/models/sign/*
!frontend/public/models/sign/.gitkeep
!**/.gitkeep
!**/*.md
*.h5
*.keras
*.tflite
*.onnx
*.pt
*.pth
*.pkl
*.joblib

# Excepcion: assets de MediaPipe del frontend SI se versionan (offline, reproducible)
!frontend/public/mediapipe/**

# ---------- Avatar / activos 3D pesados ----------
avatar/exports/*
!avatar/exports/.gitkeep
*.blend1
*.blend2

# ---------- Base de datos ----------
*.sqlite
*.sqlite3
*.db

# ---------- Archivos temporales ----------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# Grabaciones apartadas por tener muy pocas muestras para entrenar.
ai/data/pendientes/**/*.json
