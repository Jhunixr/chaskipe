ai/data/raw/*
ai/data/processed/*
!ai/data/raw/.gitkeep
!ai/data/processed/.gitkeep
ai/models/*
!ai/models/.gitkeep
*.h5
*.keras
*.tflite
*.onnx
*.pt
*.pth
*.pkl
*.joblib

# ---------- Avatar / activos 3D pesados ----------
avatar/exports/*
!avatar/exports/.gitkeep
*.blend1
*.blend2

# ---------- Base de datos ----------
*.sqlite
*.sqlite3
*.db

# ---------- Archivos temporales ----------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

