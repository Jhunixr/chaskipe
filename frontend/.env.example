# URL del backend de Chaski Pe. Copia este archivo a .env si necesitas
# cambiarla. Sin backend encendido, la app usa datos de ejemplo.
VITE_API_URL=http://localhost:8000

# Para probar desde el celular en la red local (npm run dev sirve por HTTPS):
# usa el proxy de Vite, que reenvia /backend al backend local por el mismo
# origen. Con http://localhost:8000 el celular no llegaria al backend.
# VITE_API_URL=/backend

# Produccion: la URL publica de la API desplegada en Dokploy.
# VITE_API_URL=https://api.chaskipe.ejemplo.pe
